  {%- set SHELL = {
      'education':      {'wrap': true,  'style': ''},
      'internship':     {'wrap': true,  'style': ''},
      'research_focus': {'wrap': false, 'style': 'margin-bottom:14px'},
      'opensource':     {'wrap': false, 'style': 'margin-bottom:12px'},
      'projects':       {'wrap': false, 'style': 'margin-bottom:12px'},
    } %}
  {# 条目 logo（数据里 e.logo 写平台名）：内联 SVG，不引外链——产物要能离线打开，
     也要印得进 PDF。加新平台就在这里加一条。
     这两个 logo 是**写死颜色**的（下面 ICON 那套才是 currentColor）：它们只出现在白底的
     标题行里，颜色各自对着平台品牌。2026-09-30 本人要求「标签/徽章/logo 颜色稍微淡一点」，
     做法是把这两个色各降一档（github #1e293b→#5b6673、modelscope #4d6bfe→#7d90f5）；
     同日第三轮「其他柔和回调一半」→ 各回一半到中间色（#3c4757 / #657df9）。 #}
  {%- set LOGO = {
      'github': '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="#3c4757" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>',
      'modelscope': '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="none" stroke="#657df9" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" d="M1.6 12.4V5.2c0-.6.7-.9 1.1-.5L8 9.7l5.3-5c.4-.4 1.1-.1 1.1.5v7.2"/></svg>',
    } %}
  {# hero 联系方式图标 + 段落标题图标：同样内联 SVG，但一律 currentColor（继承 hero 的白字，
     也在标题的深色圆角块里当白字用，换底色不用重画）。
     手机/邮箱/导师/实验室 四项的图标由模板定（它们是固定字段，不是列表）；
     三个外链的图标写在数据的 hero.links[].icon 里；
     段落标题的图标写在数据的 order[].icon 里（见 .dot svg 那段注释）。要加就在这儿加一条。 #}
  {%- set ICON = {
      'phone':   '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><rect x="4.2" y="1.6" width="7.6" height="12.8" rx="2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M6.9 3.7h2.2M7.2 12.3h1.6" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>',
      'mail':    '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><rect x="1.4" y="3.5" width="13.2" height="9" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M2.3 4.5 8 8.6l5.7-4.1" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>',
      'advisor': '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><circle cx="8" cy="5.1" r="2.7" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M2.9 13.8c0-2.7 2.3-4.4 5.1-4.4s5.1 1.7 5.1 4.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>',
      'lab':     '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M8 1.9 1.8 5.6v1.2h12.4V5.6z" fill="currentColor"/><path d="M3.6 8.4v4.4M6.7 8.4v4.4M9.3 8.4v4.4M12.4 8.4v4.4M2.2 14.1h11.6" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>',
      'home':    '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.25"/><path d="M1.9 8h12.2M8 1.9c1.7 2 2.6 3.9 2.6 6.1S9.7 12.1 8 14.1C6.3 12.1 5.4 10.2 5.4 8s.9-4.1 2.6-6.1z" fill="none" stroke="currentColor" stroke-width="1.25"/></svg>',
      'scholar': '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M8 2.1 15 5.6 8 9.1 1 5.6z" fill="currentColor"/><path d="M4.2 7.3v3.4c0 1.2 1.7 2.2 3.8 2.2s3.8-1 3.8-2.2V7.3" fill="none" stroke="currentColor" stroke-width="1.25"/><path d="M14.4 5.9v4.2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>',
      'github':  '<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>',
      'summary':    '<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 1.6l1.7 4.4 4.4 1.7-4.4 1.7L8 13.8 6.3 9.4 1.9 7.7l4.4-1.7z"/></svg>',
      'pubs':       '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="3.2" y="1.8" width="9.6" height="12.4" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M5.6 5.2h4.8M5.6 7.8h4.8M5.6 10.4h3" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>',
      'awards':     '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.6 1.9h6.8v4.3a3.4 3.4 0 01-6.8 0z" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4.6 3.1H2.4v1.2a2.4 2.4 0 002.4 2.4M11.4 3.1h2.2v1.2a2.4 2.4 0 01-2.4 2.4" fill="none" stroke="currentColor" stroke-width="1.1"/><path d="M8 9.6v2.4M5.2 14.1h5.6l-.6-2.1H5.8z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>',
      'skills':     '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="4.4" y="4.4" width="7.2" height="7.2" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M6.6 6.6h2.8v2.8H6.6z" fill="currentColor"/><path d="M6.4 2.2v2.2M9.6 2.2v2.2M6.4 11.6v2.2M9.6 11.6v2.2M2.2 6.4h2.2M2.2 9.6h2.2M11.6 6.4h2.2M11.6 9.6h2.2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>',
      'education':  '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.4C6.7 2.5 4.7 2.1 2.4 2.4v9.2c2.3-.3 4.3.1 5.6 1 1.3-.9 3.3-1.3 5.6-1V2.4c-2.3-.3-4.3.1-5.6 1z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M8 3.4v9.2" stroke="currentColor" stroke-width="1.1"/></svg>',
      'internship': '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.8" y="4.6" width="12.4" height="8.6" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M5.9 4.6V3.4c0-.6.5-1.1 1.1-1.1h1.9c.6 0 1.1.5 1.1 1.1v1.2M1.8 8.2h12.4" fill="none" stroke="currentColor" stroke-width="1.1"/></svg>',
      'research':   '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.1" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M10.9 5.1l-1.7 4.1-4.1 1.7 1.7-4.1z" fill="currentColor"/></svg>',
      'opensource': '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="4.2" cy="3.2" r="1.7" fill="none" stroke="currentColor" stroke-width="1.2"/><circle cx="4.2" cy="12.8" r="1.7" fill="none" stroke="currentColor" stroke-width="1.2"/><circle cx="11.8" cy="8" r="1.7" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M4.2 4.9v6.2M11.8 6.3c0 2.4-2.4 1.7-5.4 1.7" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>',
      'projects':   '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.8 3.6h4.6l1.4 1.8h6.4v7.2H1.8z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>',
    } %}
<div class="wrap">
  <div class="hero">
    {% if d.photo_uri %}
    <img src="{{ d.photo_uri }}" alt="照片">
    {% endif %}
    <div>
      <h1>{{ d.hero.name }} <span style="font-size:16px;opacity:.85">{{ d.hero.en_name }}</span></h1>
      <p class="role">{{ d.hero.tagline }}</p>
      <p class="links"><span class="hi">{{ ICON.phone }}</span>{{ d.hero.phone }} ｜ <span class="hi">{{ ICON.mail }}</span>{{ d.hero.email }} ｜ <span class="hi">{{ ICON.advisor }}</span>导师：{{ d.hero.advisor }} ｜ <span class="hi">{{ ICON.lab }}</span>{{ d.hero.lab }}
        {% for l in d.hero.links %}｜ <span class="hi">{% if l.icon %}{{ ICON.get(l.icon, '') }}{% endif %}</span><a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</p>
      {% if d.hero.badges %}
      <div class="hl-badges">
        {% for x in d.hero.badges %}<span class="hl-badge">{{ x }}</span>{% endfor %}
      </div>
      {% endif %}
    </div>
  </div>

  {# 数字横条（hero 之下那条 3 格横幅）：本人 2026-09-28 要求「不显示，但别删，
     以注释形式留在产物里，以后可能会用到」——kpis_comment_only=true 时走注释分支。
     注释里的标记与渲染分支逐字相同（都由 d.kpis 生成），所以以后把数据里那个开关去掉
     就能原样启用，不必从 git 历史里翻。
     两个坑：① HTML 注释里不能出现连续两个短横线（会提前结束注释），所以这段注释文字里
     别写 CSS 变量名（--page-pad 那种）；② 注释不是元素、不占版面，页数不受影响。
     {% if d.kpis %} 守卫必须包住整段，否则空数组会留下一条空边框（或一段空注释）。 #}
  {% if d.kpis %}
  {% if d.kpis_comment_only %}
  <!-- 数字横条：按本人 2026-09-28 的要求暂不显示，标记保留备用。
       要启用就改数据 data/C-talent.yaml 里的 kpis_comment_only（删掉或改 false）后重建；
       别直接改这个产物文件，build.py 一跑就覆盖。 -->
  <!-- <div class="kpis">{% for k in d.kpis %}<div class="kpi"><b>{{ k.num }}</b><span>{{ k.label }}</span></div>{% endfor %}</div> -->
  {% else %}
  <div class="kpis">{% for k in d.kpis %}<div class="kpi"><b>{{ k.num }}</b><span>{{ k.label }}</span></div>{% endfor %}</div>
  {% endif %}
  {% endif %}

  <div class="content">
  {# 一个段落怎么渲染只写这一处：单栏与「并排两栏」调的是同一个宏，
     否则同一段会有两种写法，改一处忘一处。
     cls 只有 .pgbreak 一个取值（数据里 order 行上的 pgbreak）——断页类必须加在
     <section> 自己身上：包一层 <div> 会把段落的 margin-bottom 一起包进去，
     页尾空白会多出一个段间距。 #}
  {%- macro section(blk, cls='') -%}
    {%- if blk is mapping %}{# ---- rail 切片：从 timeline 取 type 命中的条目 ---- #}
    {%- set sh = SHELL.get(blk.rail[0], {}) %}
    <section{% if cls %} class="{{ cls }}"{% endif %}><h2><span class="dot">{{ ICON.get(blk.icon, blk.icon) }}</span>{{ blk.title }}</h2><div class="{% if sh.wrap %}timeline{% else %}rail{% endif %}">
      {% if blk.note %}<p class="rail-note">{{ blk.note }}</p>{% endif %}
      {% for e in d.timeline if e.type in blk.rail %}
      <div class="tl-item"{% if sh.style %} style="{{ sh.style }}"{% endif %}>
        <div class="tl-head"><span class="pill-time">{{ e.time }}{% if e.meta %} · {{ e.meta }}{% endif %}</span><h3>{% if e.logo %}{{ LOGO.get(e.logo, '') }}{% endif %}{% if e.link %}<a href="{{ e.link }}">{{ e.title }}</a>{% else %}{{ e.title }}{% endif %}{% if e.sub %} <span class="org">{{ e.sub }}</span>{% endif %}</h3></div>
        {% if e.badges %}<p>{% for bd in e.badges %}<span class="badge">{{ bd }}</span>{% endfor %}</p>{% endif %}
        {% if e.body %}<p class="tl-desc">{{ md(e.body) }}</p>{% endif %}
        {% for g in e.groups %}<div class="tl-group"><div class="gtitle">▸ {{ g.title }}</div>
        <ul class="detail">{% for it in g["items"] %}<li>{{ md(it) }}</li>{% endfor %}</ul></div>{% endfor %}
        {% if e.bullets %}<ul class="detail">{% for x in e.bullets %}<li>{{ md(x) }}</li>{% endfor %}</ul>{% endif %}
      </div>{% endfor %}
    </div></section>

    {%- elif blk == 'summary' %}
    <section{% if cls %} class="{{ cls }}"{% endif %}><h2><span class="dot">{{ ICON.summary }}</span>个人简介</h2><p class="summary">{{ d.summary }}</p></section>

    {%- elif blk == 'publications' %}
    <section{% if cls %} class="{{ cls }}"{% endif %}><h2><span class="dot">{{ ICON.pubs }}</span>已录用论文（一作/共一 {{ d.publications.published | length }} 篇）</h2>
      <ol class="pubs">
        {% for p in d.publications.published %}
        <li class="pub"><span class="tag {{ p.tier }}">{{ TIER_LABEL.get(p.tier, p.tier) }}</span>
          <span class="pub-title">[{{ loop.index }}] {% if p.url %}<a href="{{ p.url }}">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</span><br>
          <span class="pub-meta">{{ p.authors }} ｜ <b>{{ p.venue }}</b>{% if p.first %} ｜ 一作{% elif p.co %} ｜ 共同一作{% endif %}</span><br>
          {% if p.note and not p.note_hidden %}<span class="pub-note">{{ p.note }}</span>{% endif %}</li>
        {% endfor %}
      </ol>
      <h4 class="subhead{% if d.publications.pgbreak %} pgbreak{% endif %}">在投论文（CCF-A，{{ d.publications.pending | length }} 篇）</h4>
      <ol class="pubs" start="{{ d.publications.published | length + 1 }}">
        {% for p in d.publications.pending %}
        <li class="pub pre"><span class="tag P">在投</span>
          <span class="pub-title">[{{ d.publications.published | length + loop.index }}] {% if p.url %}<a href="{{ p.url }}">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</span><br>
          <span class="pub-meta">{{ p.authors }} ｜ <b>{{ p.venue }}</b>（在投）{% if p.first %} ｜ 一作{% elif p.co %} ｜ 共同一作{% endif %}</span><br>
          {% if p.note and not p.note_hidden %}<span class="pub-note">{{ p.note }}</span>{% endif %}</li>
        {% endfor %}
      </ol>
    </section>

    {%- elif blk == 'awards' %}
    <section{% if cls %} class="{{ cls }}"{% endif %}><h2><span class="dot">{{ ICON.awards }}</span>荣誉奖项</h2>
      <ul class="awards">{% for a in d.awards %}<li>{{ '★ ' if a.star else '' }}{{ a.text }}{% if a.year %} · {{ a.year }}{% endif %}{% if a.subs %}<ul class="award-subs">{% for s in a.subs %}<li>{{ s }}</li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul>
    </section>

    {%- elif blk == 'skills' %}
    <section{% if cls %} class="{{ cls }}"{% endif %}><h2><span class="dot">{{ ICON.skills }}</span>技能</h2>
      <div class="skill-block">{% for s in d.skills %}<p class="skill-line"><b>{{ s.group }}：</b>{{ s["items"] | join('、') }}</p>{% endfor %}</div>
    </section>
    {%- endif %}
  {%- endmacro %}

  {%- for row in d.order %}
    {#- 数据里 order 行上的 pgbreak 只对单栏段落有意义（并排两栏从中间断开会把 grid 拆开），
        所以只有下面两个单栏分支把它传给宏 -#}
    {%- set brk = 'pgbreak' if (row is mapping and row.pgbreak) else '' %}
    {%- if row is mapping and row.pair %}{# 数组 + 逐行栏宽比：两栏高度差多少就配多少宽，别留空档 #}
    <div class="cols2" style="grid-template-columns:{{ row.ratio[0] }}fr {{ row.ratio[1] }}fr">{{ section(row.pair[0]) }}{{ section(row.pair[1]) }}</div>
    {%- elif row is string or row is mapping %}
    {{ section(row, brk) }}
    {%- else %}{# 数组 = 并排两栏：左栏在前，两栏默认等宽 #}
    <div class="cols2">{{ section(row[0]) }}{{ section(row[1]) }}</div>
    {%- endif %}
  {%- endfor %}
  </div>
</div>
</body>
</html>
